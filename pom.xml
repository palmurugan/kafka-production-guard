<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.github.palmurugan</groupId>
  <artifactId>kafka-production-guard-parent</artifactId>
  <version>0.1.0</version>
  <packaging>pom</packaging>

  <name>kafka-production-guard</name>
  <description>Production-grade Kafka consumer safety for Spring Boot: idempotency, poison-message handling and more.</description>
  <url>https://github.com/palmurugan/kafka-production-guard</url>

  <licenses>
    <license>
      <name>The Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>palmurugan</id>
      <name>Palmurugan C</name>
      <url>https://github.com/palmurugan</url>
    </developer>
  </developers>

  <scm>
    <url>https://github.com/palmurugan/kafka-production-guard</url>
    <connection>scm:git:https://github.com/palmurugan/kafka-production-guard.git</connection>
    <developerConnection>scm:git:git@github.com:palmurugan/kafka-production-guard.git</developerConnection>
    <tag>HEAD</tag>
  </scm>

  <modules>
    <module>kafka-production-guard-core</module>
    <module>kafka-production-guard-spring-boot-starter</module>
    <module>kafka-production-guard-jdbc</module>
  </modules>

  <properties>
    <java.version>17</java.version>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- Bump to the latest 3.5.x patch -->
    <spring-boot.version>3.5.6</spring-boot.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>io.github.palmurugan</groupId>
        <artifactId>kafka-production-guard-core</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.13.0</version>
          <configuration>
            <!-- required so @ConfigurationProperties records bind by parameter name -->
            <parameters>true</parameters>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.5.2</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>

  <!-- Central requires: sources jar, javadoc jar, GPG signatures, full POM metadata -->
